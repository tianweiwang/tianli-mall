APP_DEBUG = false

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai
APP_KEY = replace-with-a-strong-application-key

[DATABASE]
TYPE = mysql
HOSTNAME = crmeb_mysql
HOSTPORT = 3306
USERNAME = crmeb
PASSWORD = replace-with-the-runtime-database-password
DATABASE = crmeb
PREFIX = eb_
CHARSET = utf8mb4
DEBUG = false

[LANG]
default_lang = zh-cn

[CACHE]
DRIVER = redis
CACHE_PREFIX = cache_store:
CACHE_TAG_PREFIX = cache_tag_store:

[REDIS]
REDIS_HOSTNAME = crmeb_redis
PORT = 6379
REDIS_PASSWORD = replace-with-the-runtime-cache-password
SELECT = 0

[QUEUE]
QUEUE_NAME = store

[UPGRADE]
REMOTE_ENABLED = false
