APP_DEBUG = false

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai
APP_KEY = replace-with-a-strong-application-key

[AUTH]
; Required for v2 authentication: use a deployment epoch and an independent secret of at least 32 bytes.
; Existing deployments must retain their current valid epoch, keys and issuer unless rotation is authorized.
SESSION_EPOCH =
STAMP_KEY =
ISSUER = generic-multi-merchant

[DATABASE]
TYPE = mysql
HOSTNAME = mysql
HOSTPORT = 3306
USERNAME = crmeb
PASSWORD = replace-with-the-runtime-database-password
DATABASE = crmeb
PREFIX = eb_
CHARSET = utf8mb4
DEBUG = false

[LANG]
default_lang = zh-cn

[CACHE]
DRIVER = redis
CACHE_PREFIX = cache_store:
CACHE_TAG_PREFIX = cache_tag_store:

[REDIS]
REDIS_HOSTNAME = redis
PORT = 6379
REDIS_PASSWORD = replace-with-the-runtime-cache-password
SELECT = 0

[QUEUE]
QUEUE_NAME = store

[MARKETPLACE]
; Bind the explicitly confirmed self-operated merchant from the actual MS2 result; never guess an ID.
SELF_OPERATED_MER_ID =
ENABLED = false
TRADE_ENABLED = false
AFTERSALE_ENABLED = false
PLATFORM_CHAT_PRIVATE_WRITES_ENABLED = false
PRODUCT_VIDEO_UPLOAD_ENABLED = false
PRODUCT_VIDEO_CLOUD_UPLOAD_ENABLED = false
PAYMENT_TEST_ENABLED = false

; Persistent private directories provisioned by the release image, shared with its workers and timer.
CUSTOMER_FORM_PRIVATE_ROOT = /private/customer-form
AFTERSALE_PRIVATE_ROOT = /private/aftersale
CUSTOMER_REFUND_PRIVATE_ROOT = /private/refund
CUSTOMER_LICENCE_PRIVATE_ROOT = /private/licence
CUSTOMER_WITHDRAWAL_QR_PRIVATE_ROOT = /private/withdrawal
PLATFORM_CHAT_PRIVATE_ROOT = /private/chat
PRODUCT_VIDEO_UPLOAD_PRIVATE_ROOT = /private/product-video
PRODUCT_MEDIA_SCAN_PRIVATE_ROOT = /private/product-media-scan
PRODUCT_VIDEO_CLOUD_UPLOAD_PRIVATE_ROOT = /private/product-video-cloud

PRODUCT_MEDIA_SCAN_MAX_OPEN_LEASES = 16
PRODUCT_MEDIA_SCAN_PER_ISSUER = 4
PRODUCT_MEDIA_SCAN_MAX_TERMINAL_LEASES = 64
PRODUCT_MEDIA_SCAN_GC_BATCH = 16
PRODUCT_MEDIA_SCAN_GC_PERIOD_SECONDS = 60
PRODUCT_VIDEO_UPLOAD_MAX_OPEN_SESSIONS = 16
PRODUCT_VIDEO_UPLOAD_PER_ACTOR = 4
PRODUCT_VIDEO_UPLOAD_TTL_SECONDS = 600

; Cloud uploads stay disabled until the real staging storage and provider policy are qualified.
PRODUCT_VIDEO_CLOUD_UPLOAD_STAGING_STORAGE_ID = 0
PRODUCT_VIDEO_CLOUD_UPLOAD_MAX_OPEN_SESSIONS = 16
PRODUCT_VIDEO_CLOUD_UPLOAD_PER_ACTOR = 4
PRODUCT_VIDEO_CLOUD_UPLOAD_TTL_SECONDS = 600
PRODUCT_VIDEO_CLOUD_UPLOAD_UPLOAD_COMPLETION_BOUND_SECONDS = 0
PRODUCT_VIDEO_CLOUD_UPLOAD_QINIU_UPLOAD_URL =
PRODUCT_VIDEO_CLOUD_UPLOAD_QINIU_RS_URL =

[UPGRADE]
REMOTE_ENABLED = false
