def source_authority(pub, checked, check):
    """Preserve the complete seventeen-step authority; qualify the real28dc successor."""
    def compact(row):return {key:row[key] for key in ['bytes','sha256']}
    def pairs(items):
        result={}
        for key,value in items:check(key not in result,'UPROOT_NO_DUPLICATE_JSON_KEYS');result[key]=value
        return result
    def decode(raw):return json.loads(raw,object_pairs_hook=pairs)
    def read(pointer):
        check(type(pointer) is dict and set(pointer) in [{'path','bytes','sha256'},{'path','bytes','sha256','native9'}]
            and type(pointer['path']) is str and Path(pointer['path']).is_absolute() and '..' not in Path(pointer['path']).parts
            and type(pointer['bytes']) is int and pointer['bytes']>=0 and type(pointer['sha256']) is str
            and re.fullmatch('[a-f0-9]{64}',pointer['sha256']) is not None,'UPROOT_FIXED_COMPLETE_PUBLIC_DESCRIPTOR')
        raw=checked(pointer)
        check({'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest()}==compact(pointer),'UPROOT_COMPLETE_PINNED_BYTES')
        return raw
    def definitions(raw):
        text=raw.decode('utf8');return {node.name:ast.get_source_segment(text,node) for node in ast.parse(text).body if isinstance(node,(ast.FunctionDef,ast.ClassDef))}
    def constants(raw):
        result={}
        for node in ast.parse(raw.decode('utf8')).body:
            if isinstance(node,ast.Assign) and len(node.targets)==1 and isinstance(node.targets[0],ast.Name):
                try:result[node.targets[0].id]=ast.literal_eval(node.value)
                except (TypeError,ValueError):pass
        return result
    def patch_apply(before,raw,oldlabel='a',newlabel='b'):
        lines=raw.decode('utf8').splitlines(keepends=True);index=0;result=dict(before)
        while index<len(lines):
            check(lines[index].startswith('--- '+oldlabel+'/'),'UPROOT_PATCH_HEADER');name=lines[index][6:].rstrip('\r\n');index+=1
            check(name in before and lines[index].rstrip('\r\n')=='+++ '+newlabel+'/'+name,'UPROOT_PATCH_SAME_MEMBER');index+=1
            original=before[name].decode('utf8').splitlines(keepends=True);cursor=0;out=[]
            while index<len(lines) and lines[index].startswith('@@ '):
                match=re.fullmatch(r'@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@[^\n]*\n?',lines[index]);check(match is not None,'UPROOT_PATCH_HUNK')
                oldn=int(match[2] or 1);newn=int(match[4] or 1);start=int(match[1])-1 if oldn else int(match[1]);check(start>=cursor,'UPROOT_PATCH_ORDER')
                out.extend(original[cursor:start]);cursor=start;index+=1;used=0;made=0
                while index<len(lines) and not lines[index].startswith(('@@ ','--- '+oldlabel+'/')):
                    line=lines[index];check(line[:1] in [' ','+','-'],'UPROOT_PATCH_LINE')
                    if line[0] in [' ','-']:check(original[cursor]==line[1:],'UPROOT_PATCH_OLD_BYTES');cursor+=1;used+=1
                    if line[0] in [' ','+']:out.append(line[1:]);made+=1
                    index+=1
                check((used,made)==(oldn,newn),'UPROOT_PATCH_COUNTS')
            out.extend(original[cursor:]);result[name]=''.join(out).encode('utf8')
        return result
    prior_source=read(HISTORICAL_EIGHTEEN_M_SOURCE);prior_defs=definitions(prior_source);prior_literals=constants(prior_source)
    check({'bytes':len(prior_defs['source_authority'].encode()),'sha256':hashlib.sha256(prior_defs['source_authority'].encode()).hexdigest()}==HISTORICAL_EIGHTEEN_AUTHORITY_SOURCE
        and {key:prior_literals[key]for key in HISTORICAL_EIGHTEEN_CONSTANTS}==HISTORICAL_EIGHTEEN_CONSTANTS,'QUOTA_FULL_EIGHTEEN_BODY_ALL_USED_LITERALS')
    oldpub=decode(read(HISTORICAL_EIGHTEEN_PUBLICATION));prior_context=oldpub['finite_contexts']
