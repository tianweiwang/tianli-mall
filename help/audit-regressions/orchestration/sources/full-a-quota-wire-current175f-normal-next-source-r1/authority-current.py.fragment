        'commit-object':['cat-file','-p',pub['source_sha']],'changed-paths':['diff-tree','--no-commit-id','--name-only','-r',pub['source_sha']],
        'name-status':['diff-tree','--no-commit-id','--name-status','-r',pub['source_sha']],'head-after':['rev-parse','HEAD'],'clean-after':['status','--porcelain=v1','--untracked-files=all']}
    check(git_raw['head-before'][1]==git_raw['head-after'][1]==(pub['source_sha']+'\n').encode() and git_raw['clean-before'][1]==git_raw['clean-after'][1]==b''
        and git_raw['parent'][1]==(pub['source_sha']+' '+pub['parent']+'\n').encode() and git_raw['commit-object'][1].splitlines()[1]==('parent '+pub['parent']).encode()
        and git_raw['changed-paths'][1].decode().splitlines()==expected_paths and git_raw['name-status'][1].decode().splitlines()==['M\t'+p for p in expected_paths],'QUOTA_REAL_FULL_COMMIT_METADATA')
    expected=dict(historical['all']);blobs={};old_blobs={}
    check([row['path']for row in step['files']]==expected_paths,'QUOTA_ORDERED_REAL_CHANGED_NAMESPACE')
    for index,row in enumerate(step['files'],1):
        name=row['path'];stem='member-'+str(index);expected_git[stem+'-after']=['show',pub['source_sha']+':'+name];expected_git[stem+'-before']=['show',pub['parent']+':'+name]
        raw=git_raw[stem+'-after'][1];old=git_raw[stem+'-before'][1]
