            raw=read(receipt[stream]);check(len(raw)==receipt[stream]['bytes'] and hashlib.sha256(raw).hexdigest()==receipt[stream]['sha256'],'UPROOT_OUTER_COMPLETE_RAW_PUBLIC_DOUBLE_STREAMS')
            if stream=='stdout':decoded=[decode(line) for line in raw.splitlines()]
        check(decoded==eighth['outer_native_documents'][label]['stdout_json_lines'],'UPROOT_OUTER_ORIGINAL_PUBLIC_STDOUT_SCHEMAS_AND_ALL_FIELDS')
    check(outer['close']['finished_ns']<eighth['outer_native_documents']['zero']['created']['started_ns'],'UPROOT_TRUE_CLOSE_BEFORE_INDEPENDENT_ZERO')
    collector=values['collector'];made=values['collector_created'];ended=values['collector_terminal']
    check(made['pid']==ended['pid'] and made['argv']==['C:/Users/Vwang/AppData/Local/Programs/DockerDesktop/resources/bin/docker.exe','logs',roles['audit-ms5-paid-producer']]
        and ended['native_exit']==ended['wait_returncode']==0 and collector['container_id']==roles['audit-ms5-paid-producer']
        and collector['raw_streams_retained'] is False and collector['unprojected_line_count']==0 and collector['business_acceptance']=='INCOMPLETE'
        and collector['normal_http_response_diagnostic']==expected_diagnostic and collector['all_public_input_windows_ended'] is True,'UPROOT_ONCE_ONLY_ORIGINAL_SAFE_COLLECTOR_NOT_REEXECUTED_OR_BUSINESS_PASS')
