    check({'bytes':len(prior_defs['source_authority'].encode()),'sha256':hashlib.sha256(prior_defs['source_authority'].encode()).hexdigest()}==HISTORICAL_SIXTEEN_AUTHORITY_SOURCE
        and {key:prior_literals[key] for key in HISTORICAL_SIXTEEN_CONSTANTS}==HISTORICAL_SIXTEEN_CONSTANTS,'DIAG17_FULL_OLD_BODY_AND_ALL_USED_LITERAL_IDENTITIES')
