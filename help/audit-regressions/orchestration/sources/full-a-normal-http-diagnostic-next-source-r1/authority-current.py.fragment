    for held,pointer in zip(original_inputs['files'],seventh['Root_actual_complete_public_inputs']):
        check(pointer['path']==held['path'] and compact(pointer)==held['pin'] and held['named_before']==held['named_after'] and held['fd_open']==held['fd_after'],'DIAG17_ALL_479_ACTUAL_INPUT_JOIN')
        public_raw[pointer['path']]=read(pointer)
    check(set(oldM)==set(CURRENT_M_RESULT_KEYS33)-{'current_881_paid_producer_failure_retirement'} and len(oldM)==32
        and oldM['source_sha']==pub['parent'] and oldM['commit_chain']==historical['commit_chain'] and len(oldM['native_operations'])==1046
        and all(op['native_exit']==op['wait_returncode']==0 for op in oldM['native_operations'])
        and mroot['actual_RESULT']=={key:seventh['inputs']['M_result'][key] for key in ['path','bytes','sha256']}
        and mroot['native_operations']==1046 and mroot['M_RESULT_fields']==32 and mroot['complete_source_snapshot_rows']==31492,'DIAG17_OLD_M32_1046_METADATA_NOT_NEW_M')
    check(failure['outer_S']['pid']==51756 and failure['outer_S']['native_exit']==failure['outer_S']['wait_returncode']==failure['paid_container_exit']==1
        and failure['root_native_command_count']==len(failure['root_native_commands'])==108 and failure['paid_failure_code']=='M4C_FORM_NORMAL_HTTP_JSON_200'
        and failure['paid_failure_phase']=='paid_real_confirmation' and failure['first_throwable_location']=={'scope':'MS5_PAID_PRODUCER_THROWABLE_DIAGNOSTIC','class':'RuntimeException','file':'ms4-customer-http-normal.php','line':33,'phase':'paid_real_confirmation'}
        and failure['later_Task6_AR_Worker']=='NOT_STARTED' and failure['business_acceptance']=='INCOMPLETE','DIAG17_EXACT_OLD_PAID_AND_S_ONE_NOT_BUSINESS_SUCCESS')
    streams={};mutations=[]
    for label,count,status in [('close',93,'VERIFIED_PAID_PRODUCER_FAILURE_NORMAL_CLOSE_ZERO_RESIDUAL'),('zero',20,'VERIFIED_PAID_PRODUCER_FAILURE_INDEPENDENT_ZERO')]:
        value=values[label];receipts=seventh['native_receipts'][label]
        check(value['status']==status and value['run_id']==index['run_id'] and value['source_sha']==pub['parent'] and value['freeze_sha256']==index['freeze_sha256']
            and value['failed_outer_pid']==51756 and value['failed_outer_native_exit']==value['paid_producer_native_exit']==1 and value['full_acceptance']=='INCOMPLETE'
            and value['original_completed_native_zero']==108 and value['original_total_native_zero']==109 and value['original_source_mapping_records']==31492
            and value['paid_failure_code']==failure['paid_failure_code'] and value['paid_failure_phase']==failure['paid_failure_phase']
            and value['HTTP_child']=='NORMAL_STOPPED_ORIGINAL_GROUP_EMPTY_LISTENER_CLOSED'
            and value['form_upload_child']=='NORMAL_STOPPED_ORIGINAL_DISTINCT_GROUP_EMPTY_LISTENER_CLOSED'
            and len(value['operations'])==len(receipts)==count,'DIAG17_ALL_SAME_CURRENT_FAILURE_CLOSURE_FACTS')
        for position,(op,receipt) in enumerate(zip(value['operations'],receipts),1):
            made=decode(read(receipt['created']));ended=decode(read(receipt['terminal']));out=read(receipt['stdout']);err=read(receipt['stderr'])
            check(receipt['index']==op['index']==position and receipt['stem']==op['stem'] and ended==op and made=={'pid':op['pid'],'argv':op['argv']}
                and type(op['pid']) is int and op['pid']>0 and op['native_exit']==op['wait_returncode']==0
                and len(out)==op['stdout_bytes'] and hashlib.sha256(out).hexdigest()==op['stdout_sha256']
                and len(err)==op['stderr_bytes'] and hashlib.sha256(err).hexdigest()==op['stderr_sha256'],'DIAG17_ALL_113_REAL_NATIVE_AND_FULL_DOUBLE_STREAMS')
            streams[(label,position)]=out;args=op['argv'][1:]
            if args and (args[0] in ['stop','rm'] or len(args)>1 and args[0] in ['network','volume'] and args[1]=='rm'):
                check(label=='close' and '-f' not in args and '--force' not in args,'DIAG17_ZERO_NO_MUTATION_AND_NONFORCE_CLOSE');mutations.append(args)
        queries=value['fresh_queries'];check([(row['kind'],row['label']) for row in queries]==[(kind,tag) for kind in ['container','network','volume'] for tag in ['project','run']]
            and len({row['operation_index'] for row in queries})==6 and all(streams[(label,row['operation_index'])]==b'' for row in queries),'DIAG17_SIX_ACTUAL_EMPTY_DOUBLE_LABEL_QUERIES_EACH')
    exact_mutations=[['stop','--timeout','-1',roles['audit-mysql']],['stop','--timeout','-1',roles['audit-redis']],['rm',*sorted(expected_cids)],
        ['network','rm',failed_context['network_id']],['volume','rm',*sorted(row['name'] for row in failed_context['initial_volumes'])]]
    check(mutations==exact_mutations and close['expected_containers']==expected_cids and close['removed_containers']==3 and close['removed_internal_networks']==1
        and close['removed_original_volumes']==8 and zero['resource_mutations']==0 and zero['Host_imported'] is False and zero['close_imported_or_invoked'] is False
        and zero['close_native_operations_verified']==93 and zero['close_exact_mutating_operations_verified']==5
        and zero['close_result']=={key:seventh['inputs']['close'][key] for key in ['path','bytes','sha256']},'DIAG17_EXACT_CURRENT_3_1_8_ORDERED_MUTATIONS_AND_INDEPENDENT_ZERO')
    check(len(seventh['original_root_native_receipts'])==108,'DIAG17_ALL_108_ORIGINAL_ROOT_RECEIPTS')
    for receipt,held in zip(seventh['original_root_native_receipts'],failure['root_native_commands']):
        made=decode(read(receipt['created']));ended=decode(read(receipt['terminal']))
        check(compact(receipt['created'])==compact(held['created']) and compact(receipt['terminal'])==compact(held['terminal'])
            and made['pid']==ended['pid']==held['pid'] and ended['native_exit']==ended['wait_returncode']==held['native_exit']==0,'DIAG17_108_SAME_PID_ACTUAL_ZERO')
        for stream in ['stdout','stderr']:
            raw=read(receipt[stream]);check(len(raw)==ended[stream+'_bytes'] and hashlib.sha256(raw).hexdigest()==ended[stream+'_sha256'],'DIAG17_108_ORIGINAL_FULL_DOUBLE_STREAMS')
    outer={}
    for label,receipt in seventh['outer_native_receipts'].items():
        made=decode(read(receipt['created']));ended=decode(read(receipt['terminal']));outer[label]=ended
        check(made['pid']==ended['pid'] and ended['native_exit']==ended['wait_returncode']==(1 if label=='S' else 0),'DIAG17_ACTUAL_OUTER_M0_S1_CLOSE0_ZERO0')
        for stream in ['stdout','stderr']:
            raw=read(receipt[stream]);check(compact(ended[stream])==compact(receipt[stream]) and len(raw)==ended[stream]['bytes']
                and hashlib.sha256(raw).hexdigest()==ended[stream]['sha256'],'DIAG17_FOUR_OUTER_FULL_DOUBLE_STREAMS')
    check(outer['M']['pid']==7392 and outer['S']['pid']==51756 and outer['close']['pid']==root['close_outer_pid']==48404
        and outer['zero']['pid']==root['zero_outer_pid']==25456 and outer['close']['finished_ns']<outer['zero']['started_ns'],'DIAG17_ORIGINAL_IDENTITIES_AND_TRUE_CLOSE_BEFORE_ZERO')
    inventories=[]
    for label,leaf in [('close','GLOBAL-BEFORE.json'),('close','GLOBAL-AFTER.json'),('zero','GLOBAL-BEFORE.json'),('zero','GLOBAL-AFTER.json')]:
        path=(Path(seventh['inputs'][label]['path']).parent/leaf).as_posix();value=decode(public_raw[path]);foreign={}
        for row in value['facts']:
            if row['id'] in expected_cids:continue
            normalized=dict(row);normalized['mounts']=sorted(json.dumps(mount,sort_keys=True,separators=(',',':')) for mount in row['mounts'])
            check(row['id'] not in foreign,'DIAG17_UNIQUE_FOREIGN_CONTAINER');foreign[row['id']]=normalized
        check(value['container_count']==len(value['facts']) and len(foreign)==53,'DIAG17_COMPLETE_53_FOREIGN_FACTS');inventories.append(foreign)
    check(all(value==inventories[0] for value in inventories[1:]),'DIAG17_ALL_FOREIGN_FIELDS_AND_MOUNT_MULTISETS_EXACT')
    protected={}
    for namespace in historical['protected_namespaces']:
        paths=[name for name in expected if name.startswith(namespace+'/')];protected[namespace]={'count':len(paths),'paths_sha256':hashlib.sha256(('\n'.join(paths)+'\n').encode()).hexdigest()}
    return {**historical,'all':expected,'groups':groups,'committed':committed,'commit_chain':chain,'protected_namespaces':protected,
        'current_881_paid_producer_failure_retirement':seventh}
