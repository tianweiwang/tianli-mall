        check({'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest()}==compact(pointer),'DIAG17_COMPLETE_PINNED_BYTES')
        return raw
    def definitions(raw):
        text=raw.decode('utf8');return {node.name:ast.get_source_segment(text,node) for node in ast.parse(text).body if isinstance(node,(ast.FunctionDef,ast.ClassDef))}
    def constants(raw):
        result={}
        for node in ast.parse(raw.decode('utf8')).body:
            if isinstance(node,ast.Assign) and len(node.targets)==1 and isinstance(node.targets[0],ast.Name):
                try:result[node.targets[0].id]=ast.literal_eval(node.value)
                except (TypeError,ValueError):pass
        return result
    def patch_apply(before,raw):
        lines=raw.decode('utf8').splitlines(keepends=True);index=0;result=dict(before)
        while index<len(lines):
            check(lines[index].startswith('--- a/'),'DIAG17_PATCH_HEADER');name=lines[index][6:].rstrip('\r\n');index+=1
            check(name in before and lines[index].rstrip('\r\n')=='+++ b/'+name,'DIAG17_PATCH_SAME_MEMBER');index+=1
            original=before[name].decode('utf8').splitlines(keepends=True);cursor=0;out=[]
            while index<len(lines) and lines[index].startswith('@@ '):
                match=re.fullmatch(r'@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@[^\n]*\n?',lines[index]);check(match is not None,'DIAG17_PATCH_HUNK')
                oldn=int(match[2] or 1);newn=int(match[4] or 1);start=int(match[1])-1 if oldn else int(match[1]);check(start>=cursor,'DIAG17_PATCH_ORDER')
                out.extend(original[cursor:start]);cursor=start;index+=1;used=0;made=0
                while index<len(lines) and not lines[index].startswith(('@@ ','--- a/')):
                    line=lines[index];check(line[:1] in [' ','+','-'],'DIAG17_PATCH_LINE')
                    if line[0] in [' ','-']:check(original[cursor]==line[1:],'DIAG17_PATCH_OLD_BYTES');cursor+=1;used+=1
                    if line[0] in [' ','+']:out.append(line[1:]);made+=1
                    index+=1
