def source_authority(pub, checked, check):
    """Qualify the immutable complete fifteen-step stage, then the exact current881 layer."""
    def pairs(items):
        value = {}
        for key,item in items:
            check(key not in value, 'CURRENT881_NO_DUPLICATE_JSON_KEYS'); value[key] = item
        return value
    def decode(raw):
        return json.loads(raw, object_pairs_hook=pairs)
    def compact(row):
        return {key:row[key] for key in ['bytes','sha256']}
    def read(pointer):
        check(type(pointer) is dict and set(pointer) in [{'path','bytes','sha256'},{'path','bytes','sha256','native9'}]
            and type(pointer['path']) is str and Path(pointer['path']).is_absolute() and '..' not in Path(pointer['path']).parts
            and type(pointer['bytes']) is int and pointer['bytes'] >= 0 and type(pointer['sha256']) is str
            and re.fullmatch('[a-f0-9]{64}',pointer['sha256']) is not None, 'CURRENT881_FIXED_PUBLIC_SOURCE_DESCRIPTOR')
        if 'native9' in pointer:
            check(type(pointer['native9']) is list and len(pointer['native9']) == 9
                and all(type(x) is int for x in pointer['native9']), 'CURRENT881_ACTUAL_NATIVE_NINE_DESCRIPTOR')
        raw = checked(pointer)
        check({'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest()} == compact(pointer), 'CURRENT881_COMPLETE_PINNED_BYTES')
        return raw
    def constants(raw):
        result = {}
        for node in ast.parse(raw.decode('utf-8')).body:
            if isinstance(node,ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0],ast.Name):
                try: result[node.targets[0].id] = ast.literal_eval(node.value)
                except (ValueError,TypeError): pass
        return result
    def definitions(raw):
        text = raw.decode('utf-8')
        return {node.name:ast.get_source_segment(text,node) for node in ast.parse(text).body
            if isinstance(node,(ast.FunctionDef,ast.ClassDef))}
    def patch_apply(before, raw):
        lines = raw.decode('utf-8').splitlines(keepends=True); index = 0; result = dict(before)
        while index < len(lines):
            check(lines[index].startswith('--- a/'), 'CURRENT881_PATCH_OLD_HEADER')
            name = lines[index][6:].rstrip('\r\n'); index += 1
            check(name in before and lines[index].rstrip('\r\n') == '+++ b/'+name, 'CURRENT881_PATCH_SAME_MEMBER'); index += 1
            old = before[name].decode('utf-8').splitlines(keepends=True); out = []; cursor = 0
            while index < len(lines) and lines[index].startswith('@@ '):
                match = re.fullmatch(r'@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@[^\n]*\n?',lines[index]); check(match is not None,'CURRENT881_STANDARD_PATCH_HUNK')
                oldn = int(match[2] or 1); newn = int(match[4] or 1); start = int(match[1])-1 if oldn else int(match[1])
                check(start >= cursor,'CURRENT881_ORDERED_PATCH_HUNKS');out.extend(old[cursor:start]);cursor = start;index += 1;used = 0;made = 0
                while index < len(lines) and not lines[index].startswith(('@@ ','--- a/')):
                    line = lines[index]; check(line[:1] in [' ','+','-'],'CURRENT881_PATCH_LINE')
                    if line[0] in [' ','-']:
                        check(old[cursor] == line[1:],'CURRENT881_PATCH_FULL_OLD_CONTEXT');cursor += 1;used += 1
                    if line[0] in [' ','+']:out.append(line[1:]);made += 1
                    index += 1
                check((used,made) == (oldn,newn),'CURRENT881_PATCH_COUNTS')
            out.extend(old[cursor:]);result[name] = ''.join(out).encode('utf-8')
        return result
    old_source = read(HISTORICAL_FIFTEEN_M_SOURCE)
    old_defs = definitions(old_source)
    check({'bytes':len(old_defs['source_authority'].encode()),'sha256':hashlib.sha256(old_defs['source_authority'].encode()).hexdigest()}
        == HISTORICAL_FIFTEEN_AUTHORITY_SOURCE, 'CURRENT881_FULL_HISTORICAL_AUTHORITY_BODY_IDENTITY')
    old_constants = constants(old_source)
    check({key:old_constants[key] for key in HISTORICAL_FIFTEEN_CONSTANTS} == HISTORICAL_FIFTEEN_CONSTANTS,
        'CURRENT881_EXACT_OLD_LITERAL_CONSTANTS_NOT_CURRENT_TREE')
    historical_pub = decode(read(HISTORICAL_FIFTEEN_PUBLICATION))
__HISTORICAL_VALIDATOR__
    historical = historical_fifteen(historical_pub, checked, check)
    check(set(pub) == set(historical_pub) and pub['schema'] == 1 and type(pub['schema']) is int
        and pub['source_sha'] == COMMIT_CHAIN[-1]['source_sha'] and pub['parent'] == COMMIT_CHAIN[-1]['parent']
        and pub['source_sha'] == '8819524a60028090c55bdcd3a9da05e50eaf19d0'
        and pub['parent'] == historical_pub['source_sha'] == '2e4af47c7595947e16bef0abfa9785823b1369d5'
        and pub['scope'] == historical_pub['scope'] and pub['base_profile'] == historical_pub['base_profile']
        and pub['target_execution'] == 'NOT RUN', 'CURRENT881_EXACT_CURRENT_PUBLICATION_SCHEMA_AND_HEAD')
    context = pub['finite_contexts']; prior_context = historical_pub['finite_contexts']
    overlay_keys = {'commit_chain','committed_changes','committed_files','new_tracked_paths','actual_complete_expected_tracked_count',
        'source_counts','current_composite_customer_form_source','source_authoring_qualification_scope','current_published_source_scope'}
    extra_keys = {'historical_fifteenth_publication','current_sixteenth_source_history','current881_validation_alignment',
        'current_form_assertion_prefix_source','current_form_profile_source','current_initializer_form_syntax','current_2e4_paid_producer_failure_retirement'}
    check(set(context) == set(prior_context)|extra_keys and all(context[key] == value for key,value in prior_context.items() if key not in overlay_keys),
        'CURRENT881_ALL_ORIGINAL_CONTEXT_FACTS_RETAINED')
    check(context['historical_fifteenth_publication'] == HISTORICAL_FIFTEEN_PUBLICATION
        and context['current_sixteenth_source_history'] == SIXTEENTH_SOURCE_HISTORY
        and context['current881_validation_alignment'] == CURRENT_881_VALIDATION_ALIGNMENT
        and context['current_form_assertion_prefix_source'] == CURRENT_FORM_DELTA
        and context['current_form_profile_source'] == CURRENT_FORM_PROFILE_SOURCE
        and context['current_initializer_form_syntax'] == CURRENT_INITIALIZER_FORM_SYNTAX
        and context['current_2e4_paid_producer_failure_retirement'] == CURRENT_2E4_PAID_PRODUCER_FAILURE_RETIREMENT,
        'CURRENT881_ALL_NEW_NAMED_FIXED_AUTHORITIES')
    chain = context['commit_chain']
    check(chain == COMMIT_CHAIN and len(chain) == 16 and chain[:15] == historical['commit_chain'],
        'CURRENT881_EXACT_SIXTEEN_WITH_ALL_OLD_FIFTEEN')
    stage = decode(read(SIXTEENTH_SOURCE_HISTORY)); step = chain[15]
    check(set(stage) == {'schema','scope','source_sha','parent','kind','files','git_operations','native_count','business','worktree_mutations'}
        and stage['schema'] == 1 and type(stage['schema']) is int and stage['scope'] == 'ACTUAL_READ_ONLY_GIT_881_FORM_ASSERTION_PREFIX_THREE_FILE_STEP'
        and {key:stage[key] for key in ['kind','source_sha','parent','files']} == {key:step[key] for key in ['kind','source_sha','parent','files']}
        and step['commit'] == SIXTEENTH_SOURCE_HISTORY and step['kind'] == 'form_assertion_prefix_repair'
        and stage['native_count'] == 14 and stage['business'] == 'NOT RUN' and stage['worktree_mutations'] == 0,
        'CURRENT881_REAL_SIXTEENTH_THREE_FILE_SOURCE_STAGE')
    git_raw = {}
    for label,receipt in stage['git_operations'].items():
        check(set(receipt) == {'created','terminal','stdout','stderr'}, 'CURRENT881_GIT_RECEIPT_FOUR')
        made = decode(read(receipt['created'])); ended = decode(read(receipt['terminal'])); out = read(receipt['stdout']); err = read(receipt['stderr'])
        check(made['pid'] == ended['pid'] and made['argv'] == ended['argv'] and made['started_ns'] == ended['started_ns']
            and type(made['pid']) is int and made['pid'] > 0 and ended['native_exit'] == ended['wait_returncode'] == 0
            and compact(ended['stdout']) == compact(receipt['stdout']) and compact(ended['stderr']) == compact(receipt['stderr'])
            and err == b'' and ended['finished_ns'] >= ended['started_ns'], 'CURRENT881_REAL_GIT_SAME_PID_WAIT_AND_BOTH_COMPLETE_STREAMS')
        argv = ended['argv']; check(argv[:5] == ['git','-c','safe.directory='+MAIN_SOURCE,'-C',MAIN_SOURCE], 'CURRENT881_GIT_EXACT_CURRENT_SOURCE_ROOT')
        git_raw[label] = (argv[5:],out)
    expected_git = {'head-before':['rev-parse','HEAD'],'clean-before':['status','--porcelain=v1','--untracked-files=all'],
        'parent':['rev-list','--parents','-n','1',pub['source_sha']],'commit-object':['cat-file','-p',pub['source_sha']],
        'changed-paths':['diff-tree','--no-commit-id','--name-only','-r',pub['source_sha']],
        'name-status':['diff-tree','--no-commit-id','--name-status','-r',pub['source_sha']],
        'head-after':['rev-parse','HEAD'],'clean-after':['status','--porcelain=v1','--untracked-files=all']}
    expected_paths = ['docs/multi-merchant/CURRENT-STATUS.md','docs/multi-merchant/records/ms4/form-assertion-prefix-repair.md',
        'help/audit-regressions/isolated/lib/ms4-customer-form-normal.php']
    check([row['path'] for row in step['files']] == expected_paths and git_raw['changed-paths'][1].decode().splitlines() == expected_paths
        and git_raw['name-status'][1].decode().splitlines() == ['M\t'+expected_paths[0],'A\t'+expected_paths[1],'M\t'+expected_paths[2]],
        'CURRENT881_ACTUAL_EXACT_THREE_PATH_STATUS_DELTA')
    for label in ['head-before','head-after']:check(git_raw[label][1] == (pub['source_sha']+'\n').encode(),'CURRENT881_ACTUAL_HEAD_BEFORE_AFTER')
    for label in ['clean-before','clean-after']:check(git_raw[label][1] == b'','CURRENT881_ACTUAL_CLEAN_BEFORE_AFTER')
    check(git_raw['parent'][1] == (pub['source_sha']+' '+pub['parent']+'\n').encode()
        and git_raw['commit-object'][1].splitlines()[1] == ('parent '+pub['parent']).encode(), 'CURRENT881_ACTUAL_ONE_PARENT_COMMIT_OBJECT')
    expected = dict(historical['all']); new_blobs = {}
    for index,row in enumerate(step['files'],1):
        name = row['path']; mark = 'member-'+str(index); expected_git[mark+'-after'] = ['show',pub['source_sha']+':'+name]
        raw = git_raw[mark+'-after'][1];new_blobs[name] = raw
        check({'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest()} == row['after'], 'CURRENT881_FULL_ACTUAL_AFTER_BLOB')
        check(row['before'] == (compact(expected[name]) if name in expected else None), 'CURRENT881_FROM_COMPLETE_QUALIFIED_FIFTEENTH_EXPECTATION')
        if row['before'] is None:
            expected_git[mark+'-absent'] = ['ls-tree','--name-only',pub['parent'],'--',name]
            check(git_raw[mark+'-absent'][1] == b'' and name == expected_paths[1], 'CURRENT881_ONE_REAL_NEW_DOCUMENT')
        else:
            expected_git[mark+'-before'] = ['show',pub['parent']+':'+name]; oldraw = git_raw[mark+'-before'][1]
            check({'bytes':len(oldraw),'sha256':hashlib.sha256(oldraw).hexdigest()} == row['before'], 'CURRENT881_FULL_ACTUAL_BEFORE_BLOB')
        expected[name] = {'path':name,**row['after']}
    check(set(expected_git) == set(git_raw) and all(git_raw[key][0] == value for key,value in expected_git.items()), 'CURRENT881_CLOSED_FOURTEEN_READ_ONLY_GIT_COMMANDS')
    expected = dict(sorted(expected.items())); changes = {row['path']:dict(row) for row in prior_context['committed_changes']}
    for row in step['files']:
        if row['path'] in changes:changes[row['path']]['after'] = row['after']
        else:changes[row['path']] = row
    changes = [changes[name] for name in sorted(changes)]; committed = [expected[row['path']] for row in changes]
    requirements = sorted(set(HISTORICAL_FIFTEEN_CONSTANTS['SOURCE_REQUIREMENT_PATHS'])|set(expected_paths))
    additions = sorted(set(HISTORICAL_FIFTEEN_CONSTANTS['NEW_TRACKED_PATHS'])|{expected_paths[1]})
    check(context['committed_changes'] == changes and context['committed_files'] == committed and COMMITTED_PATHS == [row['path'] for row in changes]
        and context['new_tracked_paths'] == NEW_TRACKED_PATHS == additions and SOURCE_REQUIREMENT_PATHS == requirements
        and pub['repository_Source_requirements'] == [expected[name] for name in requirements]
        and context['actual_complete_expected_tracked_count'] == len(expected), 'CURRENT881_COMPLETE_INDEPENDENT_CUMULATIVE_NAMESPACE_REQUIREMENTS')
    proof = decode(read(CURRENT_FORM_DELTA)); form = expected_paths[2]; old_form = read(proof['before']); new_form = read(proof['candidate'])
    transform = decode(read(proof['transform'])); prefixpins = decode(read(proof['source_PINS']))
    check(proof['schema'] == 1 and proof['scope'] == 'FORM_ASSERTION_LABEL_ONLY_SIXTEENTH_CURRENT_881_SOURCE_LAYER'
        and proof['repository_path'] == transform['repository_path'] == form and proof['actual_adoption'] == SIXTEENTH_SOURCE_HISTORY
        and compact(proof['before']) == step['files'][2]['before'] and compact(proof['candidate']) == step['files'][2]['after']
        and new_form == new_blobs[form] and compact(proof['before']) == prefixpins['members']['before/ms4-customer-form-normal.php']
        and compact(proof['candidate']) == prefixpins['members']['candidate/ms4-customer-form-normal.php']
        and len(transform['changes']) == proof['changes'] == 60 and transform['assertion_conditions_or_guard_changed'] is False,
        'CURRENT881_ACTUAL_ADOPTED_FULL_FORM_DELTA_SOURCE')
    pieces = []; offset = 0; reverse_pieces = []; new_offset = 0
    for change in transform['changes']:
        start = change['offset']; old = change['old'].encode(); new = change['new'].encode()
        check(type(start) is int and start >= offset and old_form[start:start+len(old)] == old and old.startswith(b"'M4CF_")
            and new == b"'M4C_FORM_"+old[len(b"'M4CF_"):], 'CURRENT881_EXACT_FIXED_ASSERTION_SECOND_LABEL')
        pieces.extend([old_form[offset:start],new]); offset = start+len(old)
    pieces.append(old_form[offset:]); check(b''.join(pieces) == new_form and len(new_form)-len(old_form) == 240,
        'CURRENT881_COMPLETE_SIXTY_LITERAL_FORWARD_AND_ALL_OTHER_BYTES_PRESERVED')
    peer = decode(read(proof['Source_peer'])); syntax = decode(read(proof['actual_helper_syntax']))
    check(peer['status'] == 'SOURCE_ONLY_EXACT_SIXTY_DIRECT_ASSERTION_LABEL_REPAIR_PASS' and syntax['status'] == 'PASS_CANDIDATE_PHP82_SYNTAX_ONLY'
        and syntax['candidate_Source_PINS'] == proof['source_PINS'] and syntax['candidate_Source_transform'] == proof['transform']
        and syntax['container_native_exit'] == 0 and syntax['ordinary_own_container_removed'] is True
        and syntax['candidate_entry_or_transform_execution'] == 'NOT RUN' and syntax['App_or_business'] == 'NOT RUN',
        'CURRENT881_FORM_SOURCE_PEER_AND_ACTUAL_SYNTAX_NOT_BUSINESS_SUCCESS')
    profilepins = decode(read(CURRENT_FORM_PROFILE_SOURCE)); profile_root = Path(CURRENT_FORM_PROFILE_SOURCE['path']).parent
    manifest = decode(read({'path':(profile_root/'MANIFEST.json').as_posix(),**profilepins['members']['MANIFEST.json']}))
    artifact_names = [row['path'] for row in historical_pub['selected9']]
    check(len(artifact_names) == 9 and manifest['selected9'] == pub['selected9'] and manifest['predecessor'] == HISTORICAL_FIFTEEN_PACKAGE
        and manifest['form_delta'] == CURRENT_FORM_DELTA and set(manifest['before']) == set(manifest['candidate']) == set(artifact_names)
        and manifest['candidate'] == profilepins['candidate'], 'CURRENT881_FULL_PROFILE_NINE_SOURCE_LAYER')
    before9 = {}; after9 = {}
