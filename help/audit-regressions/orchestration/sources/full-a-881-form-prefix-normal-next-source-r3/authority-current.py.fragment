    values = {key:decode(read(pointer)) for key,pointer in inputs.items()}
    index = values['index']; final = values['final_peer']; failure = values['failure_authority']; oldM = values['M_result']; mroot = values['M_root_readback']
    check(sixth['schema'] == 1 and sixth['scope'] == 'SIXTH_CURRENT2E4_ACTUAL_FAILED_FULL_A_COMPLETE_PUBLIC_RETIREMENT_AUTHORITY'
        and index['status'] == 'COMPLETE_ACTUAL_FAILED_A_RETIREMENT_AUTHORITY_NOT_BUSINESS_ACCEPTANCE'
        and index['run_id'] == failure['run_id'] == '20261023082740ae535d' and index['source_sha'] == failure['source_sha'] == pub['parent']
        and index['freeze_sha256'] == failure['freeze_sha256'] == oldM['freeze_sha256']
        and index['actual_close'] == compact(inputs['close']) and index['actual_zero'] == compact(inputs['zero'])
        and index['independent_final'] == compact(inputs['final_peer']) and index['independent_global'] == compact(inputs['global_peer'])
        and index['close_zero_native_operations'] == [93,20] and index['original_S_native_exit'] == index['paid_producer_native_exit'] == 1
        and index['http_calls_completed'] == 'UNKNOWN' and index['full_business_acceptance'] == sixth['business_acceptance'] == 'INCOMPLETE'
        and index['current_run_resources_retired'] is True and index['original_failed_run_or_source_replayed'] is False,
        'CURRENT881_SIXTH_ORIGINAL_ACTUAL_FAILURE_AND_RETIREMENT_NOT_REWRITTEN')
    check(final['status'] == 'PASS_COMPLETE_ACTUAL_CURRENT_RETIREMENT_AND_INDEPENDENT_ZERO_READBACK_ONLY'
        and final['foreign_complete_projection_preserved'] is True and final['mounts_compared_as_full_entry_multisets_preserving_duplicates'] is True
        and final['foreign_original_resource_consumers'] == final['original_current_or_history_cids_remaining'] == 0
        and final['original_S_native_exit'] == final['paid_producer_native_exit'] == 1 and final['business_acceptance'] == 'INCOMPLETE'
        and final['all_join_windows_closed'] is True and values['global_peer']['status'] == 'PASS', 'CURRENT881_COMPLETE_PEER_AND_GLOBAL_RETIREMENT_SCOPE')
    check(set(oldM) == set(CURRENT_M_RESULT_KEYS32)-{'current_2e4_paid_producer_failure_retirement'}
        and len(oldM) == 31 and oldM['source_sha'] == pub['parent'] and oldM['commit_chain'] == historical['commit_chain']
        and len(oldM['native_operations']) == 1037 and all(op['native_exit'] == op['wait_returncode'] == 0 for op in oldM['native_operations'])
        and mroot['actual_RESULT'] == {key:inputs['M_result'][key] for key in ['path','bytes','sha256']}
        and mroot['native_operations'] == 1037 and mroot['M_RESULT_fields'] == 31 and mroot['complete_source_snapshot_rows'] == 31490
        and mroot['all_original_native_created_terminal_and_streams_join'] is True and mroot['outer_native_exit_wait'] == 0,
        'CURRENT881_PRESERVED_ACTUAL_OLD_M1037_AND_STRICT_HISTORICAL31')
    all_streams = {}; mutations = []
    for label,count,status in [('close',93,'VERIFIED_PAID_PRODUCER_FAILURE_NORMAL_CLOSE_ZERO_RESIDUAL'),('zero',20,'VERIFIED_PAID_PRODUCER_FAILURE_INDEPENDENT_ZERO')]:
        value = values[label];receipts = sixth['native_receipts'][label]
        check(value['status'] == status and value['run_id'] == index['run_id'] and value['source_sha'] == pub['parent']
            and value['freeze_sha256'] == index['freeze_sha256'] and value['failed_outer_pid'] == 22136
            and value['failed_outer_native_exit'] == value['paid_producer_native_exit'] == 1 and value['full_acceptance'] == 'INCOMPLETE'
            and value['original_completed_native_zero'] == 81 and value['original_total_native_zero'] == 82
            and value['original_source_mapping_records'] == 31490 and len(value['operations']) == len(receipts) == count,
            'CURRENT881_ACTUAL_CLOSE_ZERO_SAME_ORIGINAL_FAILURE_AND_ALL_OPERATIONS')
        for position,(op,receipt) in enumerate(zip(value['operations'],receipts),1):
            made = decode(read(receipt['created'])); ended = decode(read(receipt['terminal'])); out = read(receipt['stdout']); err = read(receipt['stderr'])
            check(receipt['index'] == op['index'] == position and receipt['stem'] == op['stem'] and ended == op
                and made['pid'] == op['pid'] and made['argv'] == op['argv'] and op['native_exit'] == op['wait_returncode'] == 0
                and type(op['pid']) is int and op['pid'] > 0 and len(out) == op['stdout_bytes'] and hashlib.sha256(out).hexdigest() == op['stdout_sha256']
                and len(err) == op['stderr_bytes'] and hashlib.sha256(err).hexdigest() == op['stderr_sha256'], 'CURRENT881_ALL113_TRUE_NATIVE_CREATED_TERMINAL_AND_FULL_STREAMS')
            all_streams[(label,position)] = out;args = op['argv'][1:]
            if args and (args[0] in ['stop','rm'] or len(args)>1 and args[0] in ['network','volume'] and args[1]=='rm'):
                check(label == 'close' and '-f' not in args and '--force' not in args,'CURRENT881_ZERO_NO_MUTATION_AND_NONFORCE_CLOSE');mutations.append(args)
        queries = value['fresh_queries'];check([(q['kind'],q['label']) for q in queries] == [(k,t) for k in ['container','network','volume'] for t in ['project','run']]
            and len({q['operation_index'] for q in queries}) == 6 and all(all_streams[(label,q['operation_index'])] == b'' for q in queries), 'CURRENT881_SIX_FRESH_DOUBLE_LABEL_QUERIES_PER_CLOSE_AND_ZERO')
    check(len(mutations) == 5 and values['close']['removed_containers'] == 3 and values['close']['removed_internal_networks'] == 1 and values['close']['removed_original_volumes'] == 8
        and values['zero']['resource_mutations'] == 0 and values['zero']['Host_imported'] is False and values['zero']['close_imported_or_invoked'] is False
        and values['zero']['close_native_operations_verified'] == 93 and values['zero']['close_exact_mutating_operations_verified'] == 5
        and values['zero']['close_result'] == {key:inputs['close'][key] for key in ['path','bytes','sha256']}, 'CURRENT881_ORDINARY_COMPLETE_RESOURCE_RETIREMENT_AND_INDEPENDENT_ZERO')
    check(len(sixth['original_root_native_receipts']) == len(failure['root_native_commands']) == 81
        and failure['paid_container_exit'] == failure['outer_S']['native_exit'] == failure['outer_S']['wait_returncode'] == 1
        and failure['customer_prepare_native_exit'] == 0 and failure['no_restart_retry_or_scenario_change'] is True
        and failure['business_acceptance'] == 'INCOMPLETE', 'CURRENT881_PRESERVED_ORIGINAL81_AND_PAID_ACTUAL_FAILURE')
    for receipt,held in zip(sixth['original_root_native_receipts'],failure['root_native_commands']):
        made = decode(read(receipt['created'])); ended = decode(read(receipt['terminal']))
        check(set(held['created']) == set(held['terminal']) == {'path','bytes','sha256'}
            and {key:receipt['created'][key] for key in ['path','bytes','sha256']} == held['created']
            and {key:receipt['terminal'][key] for key in ['path','bytes','sha256']} == held['terminal'] and made['pid'] == ended['pid'] == held['pid']
            and ended['native_exit'] == ended['wait_returncode'] == held['native_exit'] == 0, 'CURRENT881_ALL81_ORIGINAL_CREATED_TERMINAL_REAL_WAIT')
        for stream in ['stdout','stderr']:
            raw = read(receipt[stream]);check(len(raw) == ended[stream+'_bytes'] and hashlib.sha256(raw).hexdigest() == ended[stream+'_sha256'], 'CURRENT881_ALL81_ORIGINAL_COMPLETE_DOUBLE_STREAMS')
    outer_values = {}
    for label,receipt in sixth['outer_native_receipts'].items():
        made = decode(read(receipt['created'])); ended = decode(read(receipt['terminal'])); outer_values[label] = ended
        check(made['pid'] == ended['pid'] and ended['native_exit'] == ended['wait_returncode'] == (1 if label=='S' else 0), 'CURRENT881_ALL_REAL_OUTER_NATIVE_WAIT_M0_S1_CLOSE0_ZERO0')
        for stream in ['stdout','stderr']:
            raw = read(receipt[stream]);check(compact(ended[stream]) == compact(receipt[stream]) and len(raw) == ended[stream]['bytes']
                and hashlib.sha256(raw).hexdigest() == ended[stream]['sha256'], 'CURRENT881_ALL_FOUR_OUTERS_FULL_DOUBLE_STREAMS')
    check(outer_values['M']['pid'] == 34804 and outer_values['S']['pid'] == 22136
        and outer_values['close']['finished_ns'] < outer_values['zero']['started_ns'], 'CURRENT881_SAME_ORIGINAL_M_S_IDENTITIES_AND_CLOSE_THEN_ZERO')
    protected = {}
    for namespace in historical['protected_namespaces']:
        names = [name for name in expected if name.startswith(namespace+'/')]
        protected[namespace] = {'count':len(names),'paths_sha256':hashlib.sha256(('\n'.join(names)+'\n').encode()).hexdigest()}
    return {'all':expected,'groups':groups,'roots':historical['roots'],'extras':historical['extras'],'references':historical['references'],
        'proof_php_ini':historical['proof_php_ini'],'committed':committed,'retirement':historical['retirement'],'commit_chain':chain,'protected_namespaces':protected,
        'driver_failure_retirement':historical['driver_failure_retirement'],'early_failure_retirement':historical['early_failure_retirement'],
        'customer_prepare_failure_retirement':historical['customer_prepare_failure_retirement'],'paid_producer_failure_retirement':historical['paid_producer_failure_retirement'],
        'current_2e4_paid_producer_failure_retirement':sixth}
