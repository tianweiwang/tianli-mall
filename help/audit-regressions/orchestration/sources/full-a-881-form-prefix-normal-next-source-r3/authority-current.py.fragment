    check(changed == manifest['changed'] == sorted(['interface-v1.json','ms4-host.py','ms4-initialize.php','normal-close-ms4-fulfillment.py','source-derivation.json','verify-zero-ms4-fulfillment.py']), 'CURRENT881_SIX_CHANGES_THREE_FULL_PRESERVATIONS')
    old_interface = decode(before9['interface-v1.json']); interface = decode(after9['interface-v1.json'])
