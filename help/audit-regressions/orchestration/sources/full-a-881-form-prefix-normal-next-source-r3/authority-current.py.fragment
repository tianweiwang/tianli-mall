        for kind,table in [('before',before9),('candidate',after9)]:
            key = kind+'/'+name;check(profilepins['members'][key] == manifest[kind][name], 'CURRENT881_PROFILE_PIN_JOIN')
            table[name] = read({'path':(profile_root/key).as_posix(),**profilepins['members'][key]})
    check(patch_apply(before9,read({'path':(profile_root/'DIFF.patch').as_posix(),**profilepins['members']['DIFF.patch']})) == after9
        and patch_apply(after9,read({'path':(profile_root/'REVERSE.patch').as_posix(),**profilepins['members']['REVERSE.patch']})) == before9,
